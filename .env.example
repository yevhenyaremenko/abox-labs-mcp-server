# abox-labs-mcp-server Environment Variables
# Copy this file to .env.local and fill in actual values

# Example API keys (configure these in kmcp.yaml under tools)
# WEATHER_API_KEY=your-weather-api-key-here
# DATABASE_URL=postgresql://user:password@localhost:5432/database
# OPENAI_API_KEY=your-openai-api-key-here

# Server configuration
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8080
# MCP_LOG_LEVEL=INFO
# MCP_DEBUG=false

# Tool-specific configuration
# WEATHER_TIMEOUT=30
# DB_MAX_CONNECTIONS=10
# FILE_MAX_SIZE=10485760  # 10MB in bytes

# ---------------------------------------------------------------------------
# Phoenix / OpenTelemetry Tracing
# ---------------------------------------------------------------------------
# Set PHOENIX_COLLECTOR_ENDPOINT to enable tracing; leave unset to disable.
#
# Local Phoenix (docker run -p 6006:6006 arizephoenix/phoenix):
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
#
# Arize Cloud (https://app.phoenix.arize.com → Settings → Copy Endpoint):
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# PHOENIX_API_KEY=your-phoenix-api-key-here
#
# Project name shown in the Phoenix UI (default: abox-labs-mcp-server):
# PHOENIX_PROJECT_NAME=abox-labs-mcp-server